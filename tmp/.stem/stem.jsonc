{
  // stem 唯一配置文件（全局配置）。用户工具/agent/策略**目录即真相**：
  // 放进 .stem/tools/、.stem/agent/、.stem/context/ 即自动注册（无镜像字段）。
  // providers：模型提供商注册表（docs/s6-plan.md R13）。密钥只经环境变量注入——
  //   key_env 存**变量名**（可缺省 = 匿名/本地端点），config 永不承载明文密钥；
  //   base_url 必填（OpenAI 兼容语义：POST base_url/chat/completions，model 发裸 id）；
  //   models 为启用白名单（空数组 = 全启用）。复制本块即可接入任意兼容端点。
  "providers": {  // provider对象
    "alibaba": {  // 提供商名
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",  // 实测可用端点
      "key_env": "ALIBABA_API_KEY",  // 真实密钥在 $ALIBABA_API_KEY（-e / export 注入，勿入库）
      "models": ["qwen3.8-max", "qwen3.8-flash", "qwen3.7-plus"]   // 启用的模型，若为空则全启用
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",  // 官方端点（未实测）
      "key_env": "DEEPSEEK_API_KEY",
      "models": ["deepseek-v4-pro", "deepseek-v4-flash"]
    }
  },
  "autoApprove": false,
  "maxSteps": 8,
  // user0 内嵌 agent 类（元 agent 完整可配；tools 给出则整表替换默认——
  // 键即白名单锁 user0 自己；对子孙只供显式判定，缺席 ≠ 否决，显式 deny = 铁律）。
  "user": {
    "model": "alibaba/qwen3.8-flash",   // 可指定user0使用的模型，一般来说实例创建时会默认继承父实例使用的模型
    "tools": {
      "access_reply": "allow",
      "agent_instantiate": "allow",
      "agent_list": "allow",
      "agent_inspect": "allow",
      "agent_ancestry": "allow",
      "agent_descendants": "allow",
      "agent_class_list": "allow",
      "bus_send": "allow",
      "bus_participants": "allow",
      "context_overview": "allow",
      "context_export": "allow",
      "context_remove": "allow",
      "context_edit": "allow",
      "context_apply": "allow",
      "telemetry_query": "allow",
      "agent_set_model": "allow",
      // SKILL.md 兼容装载器（custom 约定 id，.stem/tools/skill/ 安装后生效）。
      "skill": "allow",
      "agent_class_create": "ask",
      "agent_class_update": "ask",
      "agent_terminate": "ask",
      "bash": "allow",
      "websearch": "allow",
      "webfetch": "allow",
      "read": "allow",
      "grep": "allow",
      "glob": "allow",
      "write": "ask",
      "edit": "ask"
    }
  },
  // classic 策略压缩参数（window = 估算 token 预算；threshold 触发比例）。
  "context": {
    "window": 128000,
    "compact": { "enabled": true, "threshold": 0.8, "keepRecentTurns": 3 }
  },
  // bash 工具（最小系统对外操作面；缺省项走 BASH_DEFAULTS：120s / 50k 字符）。
  "bash": {
    "defaultTimeoutMs": 120000,
    "maxOutputChars": 50000
  },
  // 三维资源矩阵（S7）：extension/ 下按资源目录分键点名启用（tools 缺省 = fs 五件套；
  // agent/context 缺省 = 不启用）。用户空间 .stem/ 各目录自动扫描，不经此清单。
  "extensions": {
    "tools": ["read", "write", "edit", "grep", "glob", "websearch", "webfetch"],
    "agent": ["creator"]
  },
  "sendCountdown": 1000
}
